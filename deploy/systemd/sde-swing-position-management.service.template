[Unit]
Description=SDE Swing Active Portfolio Management
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=__SDE_USER__
WorkingDirectory=__SDE_ROOT__
EnvironmentFile=-__SDE_ROOT__/.env
Environment=PYTHONPATH=__SDE_ROOT__:__SDE_ROOT__/src
Environment=PYTHONUNBUFFERED=1
Environment=TZ=Asia/Jakarta
ExecStart=__SDE_PYTHON__ -u __SDE_ROOT__/tools/run_server_position_management.py
TimeoutStartSec=2h
TimeoutStopSec=30
KillMode=control-group
NoNewPrivileges=true
PrivateTmp=true
