{
  "config_version": "1.7.0-multisource",
  "schema_version": "1.0.0",
  "resolver_mode": "PRIMARY_WITH_FALLBACK",
  "primary_broker_window": "5D",
  "record_ownership": {
    "DailyBar": {
      "primary": "HISTORICAL_PROVIDER",
      "fallback": [],
      "note": "Yahoo/historical provider remains the source of truth for the canonical technical series; ZAPI validates the latest closed candle only."
    },
    "IntradayQuote": {
      "primary": "INTERNAL",
      "fallback": [],
      "note": "UNSUPPORTED: ZAPI IDX catalog has no documented intraday quote endpoint."
    },
    "OrderBookSnapshot": {
      "primary": "INTERNAL",
      "fallback": [],
      "note": "UNSUPPORTED: ZAPI IDX catalog has no documented order-book endpoint."
    },
    "BrokerFlow": {
      "primary": "STOCKBIT",
      "fallback": []
    },
    "ForeignFlow": {
      "primary": "ZAPI_IDX",
      "fallback": [],
      "note": "NOT_CONFIGURED until a verified ZAPI foreign-flow schema is available. Stockbit BrokerFlow remains a separate metric."
    },
    "TradingStatus": {
      "primary": "ZAPI_IDX",
      "fallback": [],
      "fail_open_or_closed": "FAIL_CLOSED"
    },
    "MarketIndex": {
      "primary": "ZAPI_IDX",
      "fallback": ["HISTORICAL_PROVIDER"]
    },
    "CorporateAction": {
      "primary": "INTERNAL",
      "fallback": []
    },
    "SymbolMetadata": {
      "primary": "ZAPI_IDX",
      "fallback": ["STOCKBIT"]
    },
    "TechnicalIndicator": {
      "primary": "INTERNAL",
      "fallback": [],
      "note": "Technical indicators are always computed internally, never sourced."
    }
  },
  "sources": {
    "ZAPI_IDX": {
      "enabled": true,
      "priority": 10,
      "timeout": 15,
      "retry": 3,
      "backoff_base_seconds": 0.5,
      "rate_limit_per_second": 4,
      "cache_ttl_seconds": 300,
      "maximum_stale_seconds": 90,
      "minimum_coverage_ratio": 0.9,
      "fallback_policy": "ALLOW",
      "conflict_tolerance": 0.0,
      "required_fields": ["symbol", "market_date", "event_timestamp"],
      "fail_open_or_closed": "FAIL_CLOSED",
      "api_key_env": "ZAPI_IDX_API_KEY",
      "base_url_env": "ZAPI_IDX_BASE_URL",
      "documentation_configured": true,
      "capabilities": {
        "DailyBar": {
          "status": "SUPPORTED",
          "endpoint": "/stock-summary",
          "params": ["length", "start", "date", "code"]
        },
        "MarketIndex": {
          "status": "SUPPORTED",
          "endpoint": "/index-summary",
          "params": ["length", "start", "date"]
        },
        "SymbolMetadata": {
          "status": "SUPPORTED",
          "endpoints": ["/companies", "/securities"],
          "params": ["length", "start", "code", "sector", "board"]
        },
        "TradingStatus": {
          "status": "SUPPORTED",
          "endpoint": "/market-activity",
          "params": ["type"]
        },
        "BrokerFlow": {
          "status": "UNSUPPORTED",
          "endpoint": "/broker-summary",
          "reason": "Documented response has aggregate broker totals without symbol BUY/SELL/net flow fields."
        },
        "IntradayQuote": {
          "status": "UNSUPPORTED",
          "reason": "No documented endpoint."
        },
        "OrderBookSnapshot": {
          "status": "UNSUPPORTED",
          "reason": "No documented endpoint."
        },
        "ForeignFlow": {
          "status": "NOT_CONFIGURED",
          "reason": "No verified canonical mapping enabled."
        },
        "CorporateAction": {
          "status": "UNSUPPORTED",
          "reason": "No verified canonical mapping enabled."
        }
      },
      "note": "Published Zapi IDX endpoints are verified. Live mode requires ZAPI_IDX_BASE_URL and ZAPI_IDX_API_KEY; absent credentials are SKIPPED_NOT_CONFIGURED and never produce mock-labelled runtime facts."
    },
    "STOCKBIT": {
      "enabled": true,
      "priority": 20,
      "timeout": 30,
      "retry": 2,
      "maximum_stale_seconds": 172800,
      "fallback_policy": "DENY",
      "conflict_tolerance": 0.0,
      "required_fields": ["symbol", "market_date"],
      "fail_open_or_closed": "FAIL_CLOSED",
      "api_key_env": "STOCKBIT_API_KEY",
      "note": "Broker Summary / Broker Raw exports. Foreign flow uses a single primary source; foreign brokers are not summed with the aggregate foreign feed."
    },
    "HISTORICAL_PROVIDER": {
      "enabled": true,
      "priority": 30,
      "timeout": 30,
      "retry": 2,
      "maximum_stale_seconds": 259200,
      "fallback_policy": "ALLOW",
      "conflict_tolerance": 0.02,
      "required_fields": ["symbol", "market_date"],
      "fail_open_or_closed": "FAIL_OPEN",
      "note": "Existing yfinance / historical downloader path. Fallback only."
    }
  },
  "conflict_defaults": {
    "numeric_tolerance_pct": 0.005,
    "suspend_conflict_policy": "FAIL_CLOSED",
    "check_corporate_action_before_ohlc_conflict": true
  }
}
