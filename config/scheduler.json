{
  "config_version": "1.7.0-multisource",
  "timezone": "Asia/Jakarta",
  "trading_days_only": true,
  "trading_calendar": "config/trading_calendar.json",
  "data_sources_config": "config/data_sources.json",
  "runner_entrypoint": "run_sde_job_integrated.py",
  "paths": {
    "preview_root": "data/output/previews",
    "job_status_root": "data/output/job_status",
    "state_root": "data/state/scheduler",
    "job_log": "logs/sde_job_runner.log"
  },
  "output_roots": {
    "job_status": "data/output/job_status",
    "snapshots": "data/output/snapshots",
    "market_snapshots": "data/output/snapshots/market",
    "technical_snapshots": "data/output/snapshots/technical",
    "broker_snapshots": "data/output/snapshots/broker",
    "broker_multi_day_snapshots": "data/output/snapshots/broker_multi_day",
    "watchlists": "data/output/watchlists",
    "decisions": "data/output/decisions",
    "previews": "data/output/previews",
    "reports": "data/output/reports",
    "audits": "data/output/audits"
  },
  "source_validation": {
    "enabled": true,
    "execution_source": "YAHOO_HISTORICAL",
    "validation_source": "ZAPI_IDX",
    "output_dir": "data/output/source_validation",
    "price_tolerance_pct": 0.005,
    "volume_tolerance_pct": 0.2,
    "maximum_stale_days": 1,
    "minimum_coverage_ratio": 0.9,
    "max_symbols": 0,
    "bulk_page_size": 100,
    "block_on_price_mismatch": false,
    "non_blocking": false
  },
  "enhanced_reporting": {
    "enabled": true,
    "output_root": "data/output",
    "max_watchlist_messages": 5,
    "send_broker_summary_csv": true,
    "send_broker_multiday_csv": true,
    "send_final_watchlist_csv": true,
    "ai_interpretation": {
      "enabled": true,
      "provider": "GROQ",
      "model": "llama-3.3-70b-versatile",
      "fallback_to_deterministic": true,
      "immutable_engine_fields": true,
      "max_watchlist_calls": 5
    }
  },
  "market_outlook": {
    "enabled": true,
    "time": "07:30"
  },
  "post_market": {
    "enabled": true,
    "time": "16:30",
    "stage": "technical_only",
    "allow_broker_fusion": false,
    "allow_final_decision": false,
    "fallback_to_existing_on_refresh_failure": false,
    "report_mode": "compact_single_message"
  },
  "locks": {
    "stale_after_minutes": 180,
    "global_resource_lock_name": "sde_pipeline_write.lock"
  },
  "final_watchlist": {
    "enabled": true,
    "start_time": "18:00",
    "retry_interval_minutes": 5,
    "broker_retry_seconds": 300,
    "cutoff_time": "18:30",
    "broker_cutoff_time": "18:30",
    "max_detail_symbols": 5,
    "missing_broker_policy": "skip_final_watchlist",
    "strict_trade_date_match": true,
    "detail_statuses": [
      "BUY CONFIRMED",
      "BUY CANDIDATE",
      "WATCH HIGH",
      "WATCH"
    ]
  },
  "broker_readiness": {
    "minimum_broker_records": 1,
    "minimum_broker_coverage_ratio": 0.8,
    "stable_file_check_seconds": 5,
    "reject_sample_data": true,
    "required_broker_columns": [
      "EMITEN",
      "TO_DATE",
      "TOTAL_BUY",
      "TOTAL_SELL"
    ],
    "allowed_broker_sources": [
      "LIVE",
      "STOCKBIT",
      "MANUAL_FILE"
    ]
  },
  "runtime": {
    "job_lock_enabled": true,
    "global_resource_lock_enabled": true,
    "stale_lock_detection": true
  },
  "telegram": {
    "prevent_duplicate": true,
    "main_report_idempotency_by_type": true,
    "maximum_message_length": 4000,
    "split_long_messages": true,
    "html_escape_dynamic_values": true,
    "detail_cooldown_minutes": 360
  },
  "delivery": {
    "idempotency_index": "data/state/scheduler/telegram_idempotency.json",
    "delivery_log": "data/state/scheduler/delivery_log.jsonl",
    "failed_root": "data/output/failed_delivery",
    "topic_routing": {
      "market_outlook": "9",
      "post_market": "9",
      "broker_summary": "9",
      "broker_summary_csv": "9",
      "broker_multiday": "9",
      "broker_multiday_csv": "9",
      "final_watchlist_detail": "9",
      "final_watchlist_csv": "9",
      "final_watchlist": "9",
      "signal_detail": "6",
      "evaluation": "5",
      "system": "5",
      "report": ""
    }
  }
}
