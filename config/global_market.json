{
  "config_version": "1.7.0-multisource",
  "provider": "YAHOO",
  "enabled": true,
  "source_mode": "LIVE",
  "period": "10d",
  "interval": "1d",
  "retry_count": 2,
  "retry_delay_seconds": 3,
  "request_timeout_seconds": 20,
