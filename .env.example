# SDE Swing V1.7.0 — environment variables (example, no real credentials).
# Copy to `.env` (gitignored) and fill in. API keys are ONLY ever read from
# the environment; they must never be committed to config JSON or code.

# --- ZAPI IDX (multi-source primary; public base URL, secret key stays blank) ---
# Leave the key blank to keep ZAPI in NOT_CONFIGURED / mock mode.
ZAPI_IDX_BASE_URL=https://api.zpi.web.id/v1/finance:idx
ZAPI_IDX_API_KEY=

# --- Stockbit (broker summary / broker raw) ---
STOCKBIT_API_KEY=

# --- Telegram (existing) ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_THREAD_SIGNAL_ID=
TELEGRAM_THREAD_REPORT_ID=
TELEGRAM_THREAD_SYSTEM_ID=
